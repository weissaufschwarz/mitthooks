{
    "name": "@weissaufschwarz/mitthooks-drizzle",
    "version": "0.1.1",
    "private": false,
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "exports": {
        "./*.js": "./dist/*.js",
        "./*": "./dist/*.js"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org"
    },
    "repository": {
        "type": "git",
        "url": "ssh://git@github.com/weissaufschwarz/mitthooks.git",
        "directory": "packages/mitthooks-drizzle"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "lint": "eslint 'src/**/*.ts' --config .eslintrc.cjs",
        "format": "prettier --write -c ./.prettierrc '**/*.{ts,yaml,yml,json,md}'"
    },
    "dependencies": {
        "@weissaufschwarz/mitthooks": "workspace:*"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@types/node": "^22.7.3",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^8.70.1",
        "@vercel/style-guide": "^6.0.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "eslint-config-turbo": "^2.11.3",
        "eslint-plugin-only-warn": "^1.2.1",
        "typescript": "^5.6.2",
        "vitest": "^3.2.0"
    },
    "peerDependencies": {
        "drizzle-orm": "^0.44.7",
        "pg": "^8.16.3"
    }
}
